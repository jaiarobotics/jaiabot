{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "FleetDataBucketAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:GetBucketAcl"
            ],
            "Resource": [
                "{{ARN_PREFIX}}:s3:::{{DATA_BUCKET}}",
                "{{ARN_PREFIX}}:s3:::{{DATA_BUCKET}}/*"
            ]
        }
    ]
}
