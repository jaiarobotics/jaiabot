$app_block

interprocess { platform: "Jaiabot Fleet Upgrade and Configuration" }
http_address: "$http_address"
http_port: $http_port

start_paused: false
update_freq: 10

add_home_tab: false
add_scope_tab: false
add_commander_tab: false


[jaiabot.protobuf.jaiabot_upgrade_config] { 
    role: $user_role

    ansible_log_dir: "$ansible_log_dir"
    
    ansible_inventory: "$inventory"
    ansible_config: "ansible-liaison.cfg"
    this_hub: "$this_hub"
    ansible_playbook {
        file: "change-sources.yml" 
        name: "Change JaiaBot repository"
        section: "Upgrade"
        role: ADVANCED

        # added to ansible-playbook -e "repo=continuous"
        input_var {
            name: "repo"
            display_name: "Repository"
            value: "release"
            value: "beta"
            value: "continuous"
            value: "test"
        }
        input_var {
            name: "mode"
            display_name: "Delivery Mode"
            value: "online"
            value: "online_with_hub_cache"
            value: "offline"
        }
        input_var {
            name: "hub_id"
            display_name: "Hub ID for offline/hub cache updates"
            static_value: "$this_hub_index"
        }
        
    }
    ansible_playbook {
        file: "check-version.yml" 
        name: "Check for updates to JaiaBot packages"
        section: "Upgrade"
        role: USER

        # Must be present in "ansible_facts" JSON field for output of one of the tasks
        output_var {
            name: "jaiabot_current_version"
            display_name: "Current JaiaBot Version"
        }
        output_var {
            name: "jaiabot_available_version"
            display_name: "New Available JaiaBot Version"
        }
        output_var {
            name: "jaiabot_upgrade_available"
            display_name: "Minor Upgrade available?"
        }        
    }

    # Can't be run on hub, or else we remove the code and config running goby_liaison_prelaunch...
    
    # ansible_playbook {
    #     file: "uninstall.yml" 
    #     name: "Remove JaiaBot packages"
    #     role: ADVANCED
    #     output_var {
    #         name: "jaiabot_current_version"
    #         display_name: "Current JaiaBot Version"
    #     }
    # }
    
    ansible_playbook {
        file: "install.yml" 
        name: "Install or Minor Upgrade JaiaBot packages only"
        section: "Upgrade"
        role: ADVANCED
        output_var {
            name: "jaiabot_current_version"
            display_name: "Current JaiaBot Version"
        }
    }
    ansible_playbook {
        file: "upgrade-all.yml" 
        name: "Minor Upgrade Jaiabot and system packages"
        section: "Upgrade"
        role: USER
        output_var {
            name: "jaiabot_current_version"
            display_name: "Current JaiaBot Version"
        }
    }

    ansible_playbook {
        file: "major_upgrade/major-upgrade.yml" 
        name: "Major Upgrade Jaiabot and Ubuntu release (Requires Major Upgrade image to be connected to this Hub via USB Key or CD)"
        section: "Upgrade"
        role: USER

        input_var {
            name: "hub_id"
            display_name: "Hub ID for offline/hub cache updates"
            static_value: "$this_hub_index"
        }

        input_var {
            name: "do_backup"
            display_name: "Make a backup of old Ubuntu filesystem to bot and hub data drives"
            value: "yes"
            value: "no"
        }

        output_var {
            name: "major_upgrade_error"
            display_name: "Error"
        }
        
        causes_hub_reboot: true
    }

    
    ansible_playbook {
        file: "check-vpn-status.yml" 
        name: "Check for VPN Status"
        section: "VPN"
        role: USER
        output_var {
            name: "jaiabot_vpn_active_state"
            display_name: "Check VPN Active State?"
        }
        output_var {
            name: "jaiabot_vpn_enable_state"
            display_name: "Check VPN Enable State?"
        }
    }

    ansible_playbook {
        file: "change-vpn-state.yml" 
        name: "Change VPN State"
        section: "VPN"
        role: USER
        input_var {
            name: "state"
            display_name: "State"
            value: "start"
            value: "stop"
            value: "enable"
            value: "disable"
        }
    }

    ansible_playbook {
        file: "reboot-bots.yml" 
        name: "Reboot Bots"
        section: "Reboot"
        role: USER
    }
    ansible_playbook {
        file: "reboot-hubs.yml" 
        name: "Reboot Hub"
        section: "Reboot"
        role: USER
        causes_hub_reboot: true
    }    

    ansible_playbook {
        file: "factory-reset.yml" 
        name: "Factory Reset [ERASES ALL MODIFICATIONS] (Reboot Required)"
        section: "Factory"
        role: ADVANCED
        confirmation_required: true
    }    

    ansible_playbook {
        file: "factory-upgrade-all.yml" 
        name: "Upgrade all packages on Factory image [ERASES ALL MODIFICATIONS] (Reboot Required)"
        section: "Factory"
        role: DEVELOPER
        confirmation_required: true
    }

    ansible_playbook {
        file: "change-comms-links.yml" 
        name: "Change Communications Links in use"
        role: USER
        input_var {
            name: "comms_link"
            display_name: "Comms Links"
            value: "xbee"
            value: "wifi"
            value: "xbee,wifi"
        }
    }
    

    $vfleet_playbooks
}
