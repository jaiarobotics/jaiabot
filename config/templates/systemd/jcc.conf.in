<virtualhost *:80>
    ServerName hub

    Alias /updates /var/www/html/updates
    Alias /reboot-check /var/www/html/reboot-check

    WSGIDaemonProcess rest_api user=jaia group=jaia threads=5 \
        python-home=$jaiabot_share_dir/jaiabot/python/venv \
        home=$jaiabot_share_dir/jaiabot/web/rest_api
    WSGIDaemonProcess jcc user=jaia group=jaia threads=5 \
        python-home=$jaiabot_share_dir/jaiabot/python/venv \
        home=$jaiabot_share_dir/jaiabot/web/server
    WSGIScriptAlias /jaia/v0 $jaiabot_share_dir/jaiabot/web/server/app.wsgi/jaia/v0 process-group=jcc
    WSGIScriptAlias /jaia $jaiabot_share_dir/jaiabot/web/rest_api/app.wsgi/jaia process-group=rest_api
    WSGIScriptAlias / $jaiabot_share_dir/jaiabot/web/server/app.wsgi process-group=jcc

    <directory $jaiabot_share_dir/jaiabot/web/rest_api>
        WSGIApplicationGroup %{GLOBAL}
        WSGIScriptReloading On
        AllowOverride None
        Require all granted  
    </directory>

    <directory $jaiabot_share_dir/jaiabot/web/server>
        WSGIApplicationGroup %{GLOBAL}
        WSGIScriptReloading On
        AllowOverride None
        Require all granted  
    </directory>
</virtualhost>

