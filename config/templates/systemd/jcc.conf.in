<virtualhost *:80>
    ServerName hub

    Alias /updates /var/www/html/updates
    Alias /reboot-check /var/www/html/reboot-check

    WSGIDaemonProcess rest_api user=jaia group=jaia threads=5 \
        python-home=$jaiabot_share_dir/jaiabot/python/venv \
        home=$jaiabot_share_dir/jaiabot/web/rest_api
    WSGIDaemonProcess jcc user=jaia group=jaia threads=5 \
        python-home=$jaiabot_share_dir/jaiabot/python/venv \
        home=$jaiabot_share_dir/jaiabot/web/server
    WSGIScriptAlias /jaia/v0 $jaiabot_share_dir/jaiabot/web/server/app.wsgi/jaia/v0 process-group=jcc
    WSGIScriptAlias /jaia $jaiabot_share_dir/jaiabot/web/rest_api/app.wsgi/jaia process-group=rest_api
    WSGIScriptAlias / $jaiabot_share_dir/jaiabot/web/server/app.wsgi process-group=jcc

    <directory $jaiabot_share_dir/jaiabot/web/rest_api>
        WSGIApplicationGroup %{GLOBAL}
        WSGIScriptReloading On
        AllowOverride None
        Require all granted  
    </directory>

    <directory $jaiabot_share_dir/jaiabot/web/server>
        WSGIApplicationGroup %{GLOBAL}
        WSGIScriptReloading On
        AllowOverride None
        Require all granted  
    </directory>

    # Proxy JDV / JCU
    ProxyRequests Off
    ProxyPreserveHost On

    RedirectMatch 301 ^/jcu$$ /jcu/
    ProxyPass        /jcu/  http://127.0.0.1:9091/
    ProxyPassReverse /jcu/  http://127.0.0.1:9091/

    RedirectMatch 301 ^/jdv$$ /jdv/
    ProxyPass        /jdv/  http://127.0.0.1:40010/
    ProxyPassReverse /jdv/  http://127.0.0.1:40010/

    # JDV API endpoints (needed when JDV is accessed via proxy)
    # Note: More specific paths must come before less specific ones
    ProxyPass        /log/                    http://127.0.0.1:40010/log/
    ProxyPassReverse /log/                    http://127.0.0.1:40010/log/
    ProxyPass        /logs                    http://127.0.0.1:40010/logs
    ProxyPassReverse /logs                    http://127.0.0.1:40010/logs
    ProxyPass        /series                  http://127.0.0.1:40010/series
    ProxyPassReverse /series                  http://127.0.0.1:40010/series
    ProxyPass        /paths                   http://127.0.0.1:40010/paths
    ProxyPassReverse /paths                   http://127.0.0.1:40010/paths
    ProxyPass        /map                     http://127.0.0.1:40010/map
    ProxyPassReverse /map                     http://127.0.0.1:40010/map
    ProxyPass        /commands                http://127.0.0.1:40010/commands
    ProxyPassReverse /commands                http://127.0.0.1:40010/commands
    ProxyPass        /active-goal             http://127.0.0.1:40010/active-goal
    ProxyPassReverse /active-goal             http://127.0.0.1:40010/active-goal
    ProxyPass        /task-packet             http://127.0.0.1:40010/task-packet
    ProxyPassReverse /task-packet             http://127.0.0.1:40010/task-packet
    ProxyPass        /depth-contours          http://127.0.0.1:40010/depth-contours
    ProxyPassReverse /depth-contours          http://127.0.0.1:40010/depth-contours
    ProxyPass        /interpolated-drifts     http://127.0.0.1:40010/interpolated-drifts
    ProxyPassReverse /interpolated-drifts     http://127.0.0.1:40010/interpolated-drifts
    ProxyPass        /objects                 http://127.0.0.1:40010/objects
    ProxyPassReverse /objects                 http://127.0.0.1:40010/objects
    ProxyPass        /moos                    http://127.0.0.1:40010/moos
    ProxyPassReverse /moos                    http://127.0.0.1:40010/moos
    ProxyPass        /convert-if-needed       http://127.0.0.1:40010/convert-if-needed
    ProxyPassReverse /convert-if-needed       http://127.0.0.1:40010/convert-if-needed
    ProxyPass        /all-series-descriptors  http://127.0.0.1:40010/all-series-descriptors
    ProxyPassReverse /all-series-descriptors  http://127.0.0.1:40010/all-series-descriptors
    ProxyPass        /h5                      http://127.0.0.1:40010/h5
    ProxyPassReverse /h5                      http://127.0.0.1:40010/h5


</virtualhost>

