link {
    modem_id: $modem_id
    subnet_mask: $subnet_mask
    driver {
        driver_name: "jaiabot_wifi_driver"
        [jaiabot.udp.protobuf.config] { 
            local {                   
                port: $local_port
            }
            $remotes
            $hub_endpoints
            max_frame_size: 1400
            $wifi_hub_id
            subnet_mask: $subnet_mask
        }
    }
    mac { 
        type: MAC_FIXED_DECENTRALIZED 
        slot { src: $modem_id type: DATA slot_seconds: 0.5 }
    }
    ack_timeout: $ack_timeout
    # read from _sub_buffer.pb.cfg.in
    $sub_buffer
}
