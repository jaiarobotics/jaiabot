link {
    modem_id: $modem_id
    subnet_mask: $subnet_mask
    driver { 
        driver_type: DRIVER_IRIDIUM_SHORE
        [goby.acomms.iridium.protobuf.shore_config] {  

            device: DEVICE_IRIDIUM_9602_9603
            sbd_type: SBD_DIRECTIP
            
            mo_sbd_server_port: 11800

            mt_sbd_server_address: "$iridium_mt_server_address"
            mt_sbd_server_port: $iridium_mt_server_port

            $modem_imei_map
    }

        
    }
    mac { 
        type: MAC_FIXED_DECENTRALIZED
        $mac_slots
    }

    ack_timeout: $ack_timeout
    # read from _sub_buffer.pb.cfg.in
    $sub_buffer
}
