ServerHost   = localhost
ServerPort   = $moos_port
Community    = $moos_community
MOOSTimeWarp = $warp // must match app { simulation { time { warp_factor }} }

//------------------------------------------
// uProcessWatch

ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4

  watch_all = true
	nowatch   = uPokeDB*
	nowatch   = uXMS*
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = $helm_app_tick
  CommsTick  = $helm_comms_tick

  bhv_dir_not_found_ok = true

  behaviors  = $bhv_file
  domain     = course:0:359:360
  domain     = speed:0:3:31
  domain     = depth:0:200:201

  // Platform model generator for BHV_AvoidObstacleV24 obstacle avoidance
  // Note: alg=holo is broken in MOOS-IvP 24.8 (missing setPose call).
  // Using dubins as workaround. radius=5 is tight turn for JaiaBot.
  pmgen = alg=dubins#radius=5
}

//------------------------------------------
// pObstacleMgr config block

ProcessConfig = pObstacleMgr
{
  AppTick   = 4
  CommsTick = 4

  // 1. Where to look for your Python/YOLO points
  point_var = TRACKED_FEATURE

  // 2. Memory Management (How long to remember an obstacle)
  max_pts_per_cluster = 20
  max_age_per_point   = 20

  // Operator-drawn exclusion zones use a 24h duration. given_max_duration must be >= the
  // duration posted in GIVEN_OBSTACLE (86400). active=false is used to remove them explicitly.
  given_max_duration = 86400

  // Alert configuration: tells pObstacleMgr to post obstacle updates to BHV_AvoidObstacleV24
  alert = name=avoid_obs_, update_var=OBSTACLE_ALERT, alert_range=25

  // 3. Range Settings
  alert_range  = 25
  ignore_range = -1  // off — GIVEN_OBSTACLE zones must be accepted regardless of distance

  // 4. Visuals (optional, helpful for pMarineViewer)
  post_dist_to_polys = true
  post_view_polys = true
  obstacles_color = red
}


//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick        = 10
  CommsTick	 = 10
  
  platform_type   = bot
  platform_color  = yellow
  platform_length = 2
}

