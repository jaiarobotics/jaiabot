$app_block
$interprocess_block
mcu_serial {
    port: "$port"
    baud: $baud
}

# The first fluorometer is always present on BIO bots, so its stanza lives here. The tsys01
# and fluorometer_2 stanzas are optional and jaiabot_sensors uses their presence to enable
# them, so bot.py generates them whole (or as an empty string).
fluorometer {
    sample_rate: 10
    report_timeout_seconds: 20
    resend_cfg_timeout_seconds: 20
    $fluorometer_coefficients
}
$tsys01_config

$fluorometer_2_config
