$app_block
$interprocess_block

bot_id: $bot_id
gps_fix_wait_timeout_seconds: 300

rolling_stats_sample_count {
  conductivity: 1
  pressure: 1
}

initial_mission { 
  dive { 
    max_depth: 2
    depth_interval: inf
    hold_time: 0
    bottom_dive: false
  }
  
  sleep_for_minutes: 180
  min_battery_percentage: 10 
  max_stored_datasets: 10
  surface_drift_time: 10
  remote_mission_wait_minutes: 0
  data_offload_timeout_minutes: 30
  air_descent_data_offload_timeout_minutes: 0
  in_water {
    # in-water if conductivity is definitely seawater and pressure is definitely sea level or greater
    threshold { 
      check { 
        condition: GREATER_THAN 
        stat: MEAN
        conductivity: 10000 # uS/cm
        hold_time: 1 # sec
      }
      check { 
        condition: GREATER_THAN 
        stat: MEAN
        pressure: -inf # dBar
        hold_time: 1 # sec
      }
    }
  }
  
  launch_tube {
      # stuck if we get sink below a certain depth 
    stuck_threshold { 
      check { 
        condition: GREATER_THAN 
        stat: MEAN
        pressure: 20 # dBar
        hold_time: 0 # sec
      }
     }
     # cleared if we're near the surface
     cleared_threshold { 
      check { 
        condition: LESS_THAN 
        stat: MEAN
        pressure: 3 # dBar
        hold_time: 10 # sec
      }
    }
    
    recovery_action { 
      thrust_percentage: 60
      thrust_duration: 5 # seconds
      count: 3
    }
    recovery_action { 
      thrust_percentage: -30
      thrust_duration: 5 # seconds
      count: 1
    }
  }
  parachute {      
    cleared_threshold { 
        # TBD - for now make this check always pass
        check {
            condition: GREATER_THAN
            stat: MEAN
            conductivity: -inf
        }
    }
    entangled_threshold { 
        # TBD - for now make this check impossible
        check { 
            condition: GREATER_THAN 
            stat: MEAN
            conductivity: inf
        }
    }
    recovery_action {
      thrust_percentage: 60
      thrust_duration: 5 # seconds
      count: 3
    }
    recovery_action {
      thrust_percentage: -30
      thrust_duration: 5 # seconds
      count: 1
    }
  }
}


mcu_serial { 
  port: "/tmp/tty_storm_mcu" 
  baud: 19200
}
