load_protobuf {  #  (repeated)
    name: "jaiabot.protobuf.Command"  #  (required)
    publish_to {
        group: "jaiabot::self_command"
        group_numeric: 11  # jaiabot::INTERVEHICLE_API_VERSION
        layer: LAYER_INTERPROCESS
    }
} 

