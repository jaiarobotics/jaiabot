#!/bin/bash

## Regenerate inventory
/etc/jaiabot/init/jaia-create-ansible-inventory.sh -b "{{ bots | join(",") }}" -h "{{ hubs | join(",") }}" > /etc/jaiabot/inventory.yml

## Regenerate hub authorized keys
cat <<EOF > /etc/jaiabot/ssh/hub_authorized_keys
{%- for k in hub_authorized_keys %}
{{ k }}
{%- endfor %}
EOF
