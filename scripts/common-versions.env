# Versions with a `# renovate:` line above them are kept current by Renovate PRs, as
# renovate.json at the repository root configures. Caddy is pinned in
# src/web/thirdparty/caddy/go.mod, where Renovate's gomod manager updates it.
jaia_version_release_branch=3.y
jaia_version_ubuntu=26.04
jaia_version_ubuntu_codename=resolute
# renovate: datasource=github-releases depName=arduino/arduino-cli
jaia_version_arduino_cli=v1.5.0
# renovate: datasource=node-version depName=node versioning=node
jaia_version_nodejs=v26.10.0
# renovate: datasource=github-releases depName=nvm-sh/nvm
jaia_version_nvm=v0.40.2
# renovate: datasource=npm depName=npm
jaia_version_npm=11.19.1
# renovate: datasource=npm depName=webpack
jaia_version_webpack=5.111.1
# renovate: datasource=npm depName=webpack-cli
jaia_version_webpack_cli=7.2.3
# renovate: datasource=github-tags depName=raspberrypi/firmware versioning=loose
jaia_version_raspi_firmware=1.20260521
# The jaiabot-web-thirdparty tarballs; after a version change, `src/web/thirdparty/fetch.sh
# --update-checksums` refreshes the SHA-256 lines
# renovate: datasource=github-releases depName=authelia/authelia extractVersion=^v(?<version>.*)$
jaia_version_authelia=4.39.28
jaia_sha256_authelia_amd64=e8ad9ff965cbf3b93138945e13cb4b7874c999c254772b2bb77952863177699c
jaia_sha256_authelia_arm64=089f3f8bdcba962024e15283811256cea28032d1cdccc56cf4e4c1b284022faa
# renovate: datasource=github-releases depName=lldap/lldap extractVersion=^v(?<version>.*)$
jaia_version_lldap=0.6.3
jaia_sha256_lldap_amd64=e80b50ef39be61de9f1d75182b1e1fa5d82c672261c7e34fd8ffec5455ed3883
jaia_sha256_lldap_arm64=3843e3fde8dff0d2a16c51f62ec2ed318916e722857d20daa61d9175a2b7c020
jaia_sha256_lldap_bootstrap=ad5a4e86b96c756fa549a0133a6d39cd323276e500c471ceec4517d83a2ec8b1
