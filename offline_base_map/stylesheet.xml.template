<?xml version="1.0" encoding="utf-8"?>

<Map
    srs="EPSG:3857"
    background-color="${water_color}"
    buffer-size="256">

    <!-- Land and Islands -->

        <Style name="land-fill-style">
            <Rule>
                <PolygonSymbolizer fill="${land_color}"/>
            </Rule>
        </Style>

        <!-- Zoom 0-2 -->
        <Layer name="land-low"
                srs="+proj=longlat +datum=WGS84 +no_defs"
                minimum-scale-denominator="200000000">

            <StyleName>land-fill-style</StyleName>

            <Datasource>
            <Parameter name="type">shape</Parameter>
            <Parameter name="file">land_low.shp</Parameter>
            </Datasource>
        </Layer>

        <!-- Zoom 3-5 -->
        <Layer name="land-mid"
                srs="+proj=longlat +datum=WGS84 +no_defs"
                minimum-scale-denominator="25000000"
                maximum-scale-denominator="200000000">

            <StyleName>land-fill-style</StyleName>

            <Datasource>
            <Parameter name="type">shape</Parameter>
            <Parameter name="file">land_mid.shp</Parameter>
            </Datasource>
        </Layer>

        <!-- Zoom 6+ -->
        <Layer name="land-high"
                srs="+proj=longlat +datum=WGS84 +no_defs"
                maximum-scale-denominator="25000000">

            <StyleName>land-fill-style</StyleName>

            <Datasource>
            <Parameter name="type">shape</Parameter>
            <Parameter name="file">land_high.shp</Parameter>
            </Datasource>
        </Layer>

        <Layer name="minor-islands"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>land-fill-style</StyleName>

            <Datasource>
            <Parameter name="type">shape</Parameter>
            <Parameter name="file">ne_10m_minor_islands.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Urban Areas -->

        <Style name="urban-style">

            <Rule>
                <Filter>[scalerank] * 1.25 &lt;= ${z}</Filter>

                <PolygonSymbolizer fill="${urban_color}"/>

            </Rule>
        </Style>

        <Layer name="urban-areas"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>urban-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_urban_areas.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Lakes -->

        <Style name="lakes-style">
            <Rule>
                <Filter>[scalerank] * 1.25 &lt;= ${z}</Filter>
                <PolygonSymbolizer fill="${water_color}"/>
            </Rule>
        </Style>

        <Layer name="lakes"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>lakes-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_lakes.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Rivers -->

        <Style name="river-style">
            <Rule>

                <Filter>[scalerank] &lt;= ${z} + 1</Filter>

                <LineSymbolizer
                    stroke="${water_color}"
                    stroke-width="1.0"/>
            </Rule>
        </Style>

        <Layer name="rivers"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>river-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_rivers_lake_centerlines.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Cities / Ports -->

        <Style name="city-style">

            <Rule>
                <Filter>[scalerank] * 1.25 &lt;= ${z}</Filter>

                <MarkersSymbolizer
                    fill="black"
                    width="3"
                    height="3"
                    placement="point"
                    allow-overlap="true" />

                <LineSymbolizer
                    stroke="black"
                    stroke-width="1.0"/>

                <PolygonSymbolizer fill="purple"/>

            </Rule>
        </Style>

        <Layer name="ports"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>city-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_ports.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- ====================> LABELS -->

    <!-- Region Labels -->

        <Style name="region-labels-style">

            <Rule>
                <Filter>[SCALERANK] &lt;= ${z} + ${label_adjustment}</Filter>

                <TextSymbolizer
                    face-name="DejaVu Sans Book"
                    size="${label_size}"
                    fill="black"
                    placement="interior"
                    dy="0">
                    [NAME]
                </TextSymbolizer>
            </Rule>
        </Style>

        <Layer name="region-labels"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>region-labels-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_geography_regions_polys.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Marine Region Labels -->

        <Style name="marine-region-labels-style">

            <Rule>
                <Filter>[scalerank] &lt;= ${z} + ${label_adjustment}</Filter>

                <TextSymbolizer
                    face-name="DejaVu Sans Oblique"
                    size="${label_size}"
                    fill="black"
                    placement="interior"
                    dy="0">
                    [label]
                </TextSymbolizer>
            </Rule>
        </Style>

        <Layer name="marine-region-labels"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>marine-region-labels-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_geography_marine_polys.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- City / Port Labels -->

        <Style name="city-label-style">
            <Rule>
                <Filter>[scalerank] &lt;= ${z} + ${label_adjustment}</Filter>

                <TextSymbolizer
                    face-name="DejaVu Sans Oblique"
                    size="${label_size}"
                    fill="black"
                    placement="point"
                    placement-type="simple"
                    placements="E,W,N,S,NE,NW,SE,SW"
                    horizontal-alignment="auto"
                    vertical-alignment="auto"
                    margin="3"
                    allow-overlap="false"
                    dx="5"
                    dy="5">
                    [name]
                </TextSymbolizer>
            </Rule>
        </Style>

        <Layer name="city-labels"
                srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>city-label-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_ports.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- Lake Labels -->

        <Style name="lake-labels-style">
            <Rule>
                <Filter>[scalerank] &lt;= ${z} + ${label_adjustment}</Filter>

                <TextSymbolizer
                    face-name="DejaVu Sans Oblique"
                    size="${label_size}"
                    fill="black"
                    placement="interior"
                    dy="0">
                    [label]
                </TextSymbolizer>
            </Rule>
        </Style>

        <Layer name="lake-labels"
        srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>lake-labels-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_lakes.shp</Parameter>
            </Datasource>
        </Layer>

    <!-- River Labels -->

        <Style name="river-label-style">
            <Rule>
                <Filter>[scalerank] &lt;= ${z} + ${label_adjustment}</Filter>

                <TextSymbolizer
                    face-name="DejaVu Sans Oblique"
                    size="${label_size}"
                    fill="black"
                    placement="line"
                    dy="-3">
                    [label]
                </TextSymbolizer>
            </Rule>
        </Style>

        <Layer name="river-labels"
        srs="+proj=longlat +datum=WGS84 +no_defs">

            <StyleName>river-label-style</StyleName>

            <Datasource>
                <Parameter name="type">shape</Parameter>
                <Parameter name="file">ne_10m_rivers_lake_centerlines.shp</Parameter>
            </Datasource>
        </Layer>

</Map>
