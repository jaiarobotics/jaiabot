#!/bin/sh -e

# Source debconf library.
. /usr/share/debconf/confmodule

# Enable backup capability
db_capb backup

# General function for handling debconf input and go
# Returns 0 if the user moves forward, 1 if the user chooses to back up
debconf_input_and_go() {
    db_input "$1" "$2" || true
    if db_go; then
        return 0
    else
        return 1
    fi
}

go_menu() {
    db_fset $1 seen false
    db_input high $1 || true
    db_go
    db_get $1
    state=$RET
}

# There are too many fleet ids to offer as debconf Choices, so the question is a string and its
# range is checked here instead. 'jaia_bounds' is in jaiabot-apps, which a first install has not
# unpacked by the time this runs, so only the form of the answer can be checked then; the postinst
# rejects an out-of-range fleet id either way, as every address it computes comes from the range.
fleet_id_is_valid() {
    local value min max

    db_get jaiabot-embedded/fleet_id
    value="$RET"

    case "${value}" in
        ''|*[!0-9]*) return 1 ;;
    esac

    if command -v jaia_bounds > /dev/null 2>&1; then
        min=$(jaia_bounds --fleet_id --min)
        max=$(jaia_bounds --fleet_id --max)
        [ "${value}" -ge "${min}" ] && [ "${value}" -le "${max}" ]
    fi
}

# State machine for common configuration
configure_common() {
    local state="type"
    while true; do
        db_set jaiabot-embedded/debconf_state_common $state
        case $state in
            "type")
                if debconf_input_and_go high jaiabot-embedded/type; then
                    state="fleet_id"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "fleet_id")
                if debconf_input_and_go high jaiabot-embedded/fleet_id; then
                    if fleet_id_is_valid; then
                        state="led_type"
                    else
                        db_input critical jaiabot-embedded/fleet_id_invalid || true
                        db_go || true
                        # ask again rather than configure the node onto a fleet that cannot exist
                        db_fset jaiabot-embedded/fleet_id seen false
                    fi
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "led_type")
                if debconf_input_and_go high jaiabot-embedded/led_type; then
                    state="electronics_stack"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "electronics_stack")
                if debconf_input_and_go high jaiabot-embedded/electronics_stack; then
                    state="rf_encryption_password"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "rf_encryption_password")
                if debconf_input_and_go medium jaiabot-embedded/rf_encryption_password; then
                    state="dccl_encryption_password"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "dccl_encryption_password")
                if debconf_input_and_go medium jaiabot-embedded/dccl_encryption_password; then
                    state="comms_links"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "comms_links")
                if debconf_input_and_go medium jaiabot-embedded/comms_links; then
                    state="mode"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "mode")
                if debconf_input_and_go medium jaiabot-embedded/mode; then
                    db_get jaiabot-embedded/mode
                    JAIA_MODE=$RET
                    if [ "$JAIA_MODE" = "simulation" ]; then
                        state="warp"
                    else
                        return 0  # Success, end configuration
                    fi
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            # only ask if mode == simulation
            "warp")
                if debconf_input_and_go medium jaiabot-embedded/warp; then
                    return 0  # Success, end configuration
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "NEXT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_common: $state"
                return 1
                ;;
        esac
    done
}

# State machine for "bot" configuration
configure_bot() {
    local state="bot_id"
    while true; do
        db_set jaiabot-embedded/debconf_state_bot $state
        case $state in
            "BACK")
                return 1
                ;;
            "bot_id")
                if debconf_input_and_go high jaiabot-embedded/bot_id; then
                    state="arduino_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "arduino_type")
                if debconf_input_and_go high jaiabot-embedded/arduino_type; then
                    db_get jaiabot-embedded/arduino_type
                    ARDUINO_TYPE=$RET
                    # backwards compatibility for old arduino_type settings
                    if [ "$ARDUINO_TYPE" = "usb_old" ] || [ "$ARDUINO_TYPE" = "usb_new" ]; then
                        db_set jaiabot-embedded/arduino_type usb
                    fi
                    state="bot_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "bot_type")
                if debconf_input_and_go high jaiabot-embedded/bot_type; then
                    db_get jaiabot-embedded/bot_type
                    BOT_TYPE_VAL=$RET
                    # backwards compatibility: migrate legacy 'echo' value to 'pam'
                    if [ "$BOT_TYPE_VAL" = "echo" ]; then
                        db_set jaiabot-embedded/bot_type pam
                    fi
                    # normalized here rather than in postinst so the on-disk database
                    # stays authoritative for everything that reads it, incl. systemd.py
                    if [ "$BOT_TYPE_VAL" = "none" ]; then
                        db_set jaiabot-embedded/bot_type hydro
                    fi
                    state="pam_connection_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "pam_connection_type")
                db_get jaiabot-embedded/bot_type
                BOT_TYPE="$RET"

                if [ "$BOT_TYPE" = "pam" ]; then
                    if debconf_input_and_go high jaiabot-embedded/pam_connection_type; then
                        state="imu_type"
                    else
                        go_menu jaiabot-embedded/debconf_state_bot
                    fi
                else
                    db_set jaiabot-embedded/pam_connection_type none
                    state="imu_type"
                fi
                ;;
            "imu_type")
                if debconf_input_and_go high jaiabot-embedded/imu_type; then
                    state="data_offload_ignore_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "data_offload_ignore_type")
                if debconf_input_and_go medium jaiabot-embedded/data_offload_ignore_type; then
                    state="imu_install_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "imu_install_type")
                if debconf_input_and_go medium jaiabot-embedded/imu_install_type; then
                    state="temperature_sensor_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "temperature_sensor_type")
                if debconf_input_and_go medium jaiabot-embedded/temperature_sensor_type; then
                    state="pressure_sensor_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "pressure_sensor_type")
                if debconf_input_and_go medium jaiabot-embedded/pressure_sensor_type; then
                    state="motor_harness_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "motor_harness_type")
                if debconf_input_and_go medium jaiabot-embedded/motor_harness_type; then
                    state="camera_positions"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "camera_positions")
                # If this was a legacy BIO bot, preseed a sensible default once.
                db_get jaiabot-embedded/bot_type
                BOT_TYPE="$RET"

                if [ "$BOT_TYPE" = "bio" ]; then
                    # Only preseed if the user hasn't answered this before
                    db_fget jaiabot-embedded/camera_positions seen
                    SEEN="$RET"
                    if [ "$SEEN" != "true" ]; then
                        db_set jaiabot-embedded/camera_positions aft
                    fi
                fi
                if debconf_input_and_go medium jaiabot-embedded/camera_positions; then
                    state="additional_sensors"
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "additional_sensors")
                if debconf_input_and_go medium jaiabot-embedded/additional_sensors; then
                    return 0 # success, end configuration
                else
                    go_menu jaiabot-embedded/debconf_state_bot

                fi
                ;;
            "EXIT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_bot: $state"
                return 1
                ;;
        esac
    done
}

# State machine for "hub" configuration
configure_hub() {
    local state="hub_id"
    # a hub has no bot type; set here so postinst never writes to the database
    db_set jaiabot-embedded/bot_type none
    while true; do
        db_set jaiabot-embedded/debconf_state_hub $state
        case $state in
            "BACK")
                return 1
                ;;
            "hub_id")
                if debconf_input_and_go high jaiabot-embedded/hub_id; then
                    state="user_role"
                else
                    go_menu jaiabot-embedded/debconf_state_hub
                fi
                ;;
            "user_role")
                if debconf_input_and_go medium jaiabot-embedded/user_role; then
                    return 0  # success, end configuration
                else
                    go_menu jaiabot-embedded/debconf_state_hub
                fi
                ;;            
            "EXIT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_hub: $state"
                return 1
                ;;
        esac
    done
}

# State machine for overall configuration
configure() {
    local state="CONFIGURE_COMMON"
    while true; do
        case $state in
            "CONFIGURE_COMMON")
                if configure_common; then
                    db_get jaiabot-embedded/type
                    JAIA_TYPE=$RET                    
                    if [ "$JAIA_TYPE" = "bot" ]; then
                        state="CONFIGURE_BOT"
                    elif [ "$JAIA_TYPE" = "hub" ]; then
                        state="CONFIGURE_HUB"
                    fi
                fi
                ;;
            "CONFIGURE_BOT")
                if configure_bot; then
                    return 0  # Success, end configuration
                else
                    state="CONFIGURE_COMMON"
                fi
                ;;            
            "CONFIGURE_HUB")
                if configure_hub; then
                    return 0  # Success, end configuration
                else
                    state="CONFIGURE_COMMON"
                fi
                ;;            
            *)
                echo "Invalid state encountered in configure: $state"
                return 1
                ;;
        esac
    done
}

configure
