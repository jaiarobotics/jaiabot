#!/bin/sh -e

# Generated from src/lib/messages/fleet_config.proto by scripts/build/fleet-config-debconf-gen.py - do not edit

# Source debconf library.
. /usr/share/debconf/confmodule

# Enable backup capability
db_capb backup

# General function for handling debconf input and go
# Returns 0 if the user moves forward, 1 if the user chooses to back up
debconf_input_and_go() {
    db_input "$1" "$2" || true
    if db_go; then
        return 0
    else
        return 1
    fi
}

go_menu() {
    db_fset $1 seen false
    db_input high $1 || true
    db_go
    db_get $1
    state=$RET
}

# The bot, hub and fleet ids are runs of integers too long to offer as debconf Choices, so those
# questions are strings and their ranges are checked here instead. Each one names its own
# 'jaia_bounds' flag. That tool is in jaiabot-apps, which a first install has not unpacked by the
# time this runs, so only the form of the answer can be checked then; the postinst rejects an
# out-of-range id either way, as every address and hostname it builds comes from the ranges.
id_is_valid() {
    local question="$1" value min max

    db_get jaiabot-embedded/${question}
    value="$RET"

    case "${value}" in
        ''|*[!0-9]*) return 1 ;;
    esac

    if command -v jaia_bounds > /dev/null 2>&1; then
        min=$(jaia_bounds --${question} --min)
        max=$(jaia_bounds --${question} --max)
        [ "${value}" -ge "${min}" ] && [ "${value}" -le "${max}" ]
    fi
}

# State machine for "common" configuration
configure_common() {
    local state="type"
    while true; do
        db_set jaiabot-embedded/debconf_state_common $state
        case $state in
            "type")
                if debconf_input_and_go medium jaiabot-embedded/type; then
                    state="fleet_id"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "fleet_id")
                if debconf_input_and_go medium jaiabot-embedded/fleet_id; then
                    if id_is_valid fleet_id; then
                        state="led_type"
                    else
                        db_input critical jaiabot-embedded/fleet_id_invalid || true
                        db_go || true
                        db_fset jaiabot-embedded/fleet_id seen false
                    fi
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "led_type")
                if debconf_input_and_go medium jaiabot-embedded/led_type; then
                    state="electronics_stack"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "electronics_stack")
                if debconf_input_and_go medium jaiabot-embedded/electronics_stack; then
                    state="rf_encryption_password"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "rf_encryption_password")
                if debconf_input_and_go medium jaiabot-embedded/rf_encryption_password; then
                    state="dccl_encryption_password"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "dccl_encryption_password")
                if debconf_input_and_go medium jaiabot-embedded/dccl_encryption_password; then
                    state="comms_links"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "comms_links")
                if debconf_input_and_go medium jaiabot-embedded/comms_links; then
                    state="mode"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "mode")
                if debconf_input_and_go medium jaiabot-embedded/mode; then
                    state="warp"
                else
                    go_menu jaiabot-embedded/debconf_state_common
                fi
                ;;
            "warp")
                db_get jaiabot-embedded/mode
                if [ "$RET" = "simulation" ]; then
                    if debconf_input_and_go medium jaiabot-embedded/warp; then
                        return 0  # end of common questions
                    else
                        go_menu jaiabot-embedded/debconf_state_common
                    fi
                else
                    return 0  # end of common questions
                fi
                ;;
            "NEXT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_common: $state"
                return 1
                ;;
        esac
    done
}

# State machine for "bot" configuration
configure_bot() {
    local state="bot_id"
    while true; do
        db_set jaiabot-embedded/debconf_state_bot $state
        case $state in
            "BACK")
                return 1
                ;;
            "bot_id")
                if debconf_input_and_go medium jaiabot-embedded/bot_id; then
                    if id_is_valid bot_id; then
                        state="arduino_type"
                    else
                        db_input critical jaiabot-embedded/bot_id_invalid || true
                        db_go || true
                        db_fset jaiabot-embedded/bot_id seen false
                    fi
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "arduino_type")
                if debconf_input_and_go medium jaiabot-embedded/arduino_type; then
                    db_get jaiabot-embedded/arduino_type
                    case "$RET" in
                        usb_old) db_set jaiabot-embedded/arduino_type usb ;;
                        usb_new) db_set jaiabot-embedded/arduino_type usb ;;
                    esac
                    state="bot_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "bot_type")
                if debconf_input_and_go medium jaiabot-embedded/bot_type; then
                    db_get jaiabot-embedded/bot_type
                    case "$RET" in
                        echo) db_set jaiabot-embedded/bot_type pam ;;
                        none) db_set jaiabot-embedded/bot_type hydro ;;
                    esac
                    state="pam_connection_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "pam_connection_type")
                db_get jaiabot-embedded/bot_type
                if [ "$RET" = "pam" ]; then
                    if debconf_input_and_go medium jaiabot-embedded/pam_connection_type; then
                        state="imu_type"
                    else
                        go_menu jaiabot-embedded/debconf_state_bot
                    fi
                else
                    db_set jaiabot-embedded/pam_connection_type none
                    state="imu_type"
                fi
                ;;
            "imu_type")
                if debconf_input_and_go medium jaiabot-embedded/imu_type; then
                    state="data_offload_ignore_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "data_offload_ignore_type")
                if debconf_input_and_go medium jaiabot-embedded/data_offload_ignore_type; then
                    state="imu_install_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "imu_install_type")
                if debconf_input_and_go medium jaiabot-embedded/imu_install_type; then
                    state="temperature_sensor_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "temperature_sensor_type")
                if debconf_input_and_go medium jaiabot-embedded/temperature_sensor_type; then
                    state="pressure_sensor_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "pressure_sensor_type")
                if debconf_input_and_go medium jaiabot-embedded/pressure_sensor_type; then
                    state="motor_harness_type"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "motor_harness_type")
                if debconf_input_and_go medium jaiabot-embedded/motor_harness_type; then
                    state="camera_positions"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "camera_positions")
                if debconf_input_and_go medium jaiabot-embedded/camera_positions; then
                    state="additional_sensors"
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "additional_sensors")
                if debconf_input_and_go medium jaiabot-embedded/additional_sensors; then
                    return 0  # end of bot questions
                else
                    go_menu jaiabot-embedded/debconf_state_bot
                fi
                ;;
            "EXIT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_bot: $state"
                return 1
                ;;
        esac
    done
}

# State machine for "hub" configuration
configure_hub() {
    local state="hub_id"
    db_set jaiabot-embedded/bot_type none
    db_set jaiabot-embedded/pam_connection_type none
    while true; do
        db_set jaiabot-embedded/debconf_state_hub $state
        case $state in
            "BACK")
                return 1
                ;;
            "hub_id")
                if debconf_input_and_go medium jaiabot-embedded/hub_id; then
                    if id_is_valid hub_id; then
                        state="user_role"
                    else
                        db_input critical jaiabot-embedded/hub_id_invalid || true
                        db_go || true
                        db_fset jaiabot-embedded/hub_id seen false
                    fi
                else
                    go_menu jaiabot-embedded/debconf_state_hub
                fi
                ;;
            "user_role")
                if debconf_input_and_go medium jaiabot-embedded/user_role; then
                    return 0  # end of hub questions
                else
                    go_menu jaiabot-embedded/debconf_state_hub
                fi
                ;;
            "EXIT")
                return 0
                ;;
            *)
                echo "Invalid state encountered in configure_hub: $state"
                return 1
                ;;
        esac
    done
}

# State machine for overall configuration
configure() {
    local state="CONFIGURE_COMMON"
    while true; do
        case $state in
            "CONFIGURE_COMMON")
                if configure_common; then
                    db_get jaiabot-embedded/type
                    JAIA_TYPE=$RET
                    if [ "$JAIA_TYPE" = "bot" ]; then
                        state="CONFIGURE_BOT"
                    elif [ "$JAIA_TYPE" = "hub" ]; then
                        state="CONFIGURE_HUB"
                    fi
                fi
                ;;
            "CONFIGURE_BOT")
                if configure_bot; then
                    return 0  # Success, end configuration
                else
                    state="CONFIGURE_COMMON"
                fi
                ;;
            "CONFIGURE_HUB")
                if configure_hub; then
                    return 0  # Success, end configuration
                else
                    state="CONFIGURE_COMMON"
                fi
                ;;
            *)
                echo "Invalid state encountered in configure: $state"
                return 1
                ;;
        esac
    done
}

configure
