#!/bin/bash
set -e

. /usr/share/debconf/confmodule

# Only the values this script itself needs are read here: the node's identity
# (for the hostname, addressing and VPN) and the arduino type (for flashing).
# Everything else is read straight from debconf by systemd.py, which is what
# actually needs it. Note that bot_type normalization now happens in the
# .config script, so this script never writes to the debconf database - that
# keeps the on-disk copy authoritative for anything reading it.
db_get jaiabot-embedded/type
JAIA_TYPE=$RET

if [ "$JAIA_TYPE" = "bot" ]; then
    db_get jaiabot-embedded/bot_id
    BOT_OR_HUB_INDEX=$RET
elif [ "$JAIA_TYPE" = "hub" ]; then
    db_get jaiabot-embedded/hub_id
    BOT_OR_HUB_INDEX=$RET
fi

db_get jaiabot-embedded/fleet_id
FLEET_INDEX=$RET

db_get jaiabot-embedded/arduino_type
JAIA_ARDUINO_TYPE=$RET

# WLAN (fleet) addressing, as defined by the 'jaia_ip' tool
NODE_WLAN_IP=$(/usr/bin/jaia_ip --query_type addr --node_type ${JAIA_TYPE} --node_id ${BOT_OR_HUB_INDEX} --ip_net wlan --fleet_id ${FLEET_INDEX} --ip_version ipv4)
FLEET_WLAN_NET=$(/usr/bin/jaia_ip --query_type net --ip_net wlan --fleet_id ${FLEET_INDEX} --ip_version ipv4)
HUB0_WLAN_IP=$(/usr/bin/jaia_ip --query_type addr --node_type hub --node_id 0 --ip_net wlan --fleet_id ${FLEET_INDEX} --ip_version ipv4)

OLD_HOST_NAME=`/bin/hostname`
NEW_HOST_NAME=${JAIA_TYPE}${BOT_OR_HUB_INDEX}-fleet${FLEET_INDEX}

if [[ "$NEW_HOST_NAME" != "$OLD_HOST_NAME" ]]; then
    echo ">>>>> Setting hostname to $NEW_HOST_NAME (log out and in again for the prompt to change) ... "
     /usr/bin/hostnamectl set-hostname $NEW_HOST_NAME
     sed -i "s/^\(127\.0\.[0-9\.]*\).*${OLD_HOST_NAME}$/\1\t${NEW_HOST_NAME}/" /etc/hosts
     sed -i "s/^\(10\.23\.[0-9\.]*\).*${OLD_HOST_NAME}$/${NODE_WLAN_IP} ${NEW_HOST_NAME}/" /etc/hosts
    echo "<<<<< Setting hostname complete!"
fi

echo ">>>>> Updating wifi configuration ... "

FLEET_WLAN_SSID="JAIA-HUB-WIFI-${FLEET_INDEX}"
NETENV_FILE=/etc/jaiabot/network.env
FLEET_ADDRESS="${NODE_WLAN_IP}/${FLEET_WLAN_NET##*/}"
FLEET_GATEWAY=$(/usr/bin/jaia_ip --query_type addr --node_type gateway --ip_net wlan --fleet_id ${FLEET_INDEX} --ip_version ipv4)

# In place upgrades from 1.y -> 2.y won't have /etc/jaiabot/network.env, so we need to create it
if [ ! -f "${NETENV_FILE}" ]; then
    # if possible, read existing wifi password
    OLD_WLAN_NETWORK_FILE="/etc/network/interfaces.d/wlan0"
    if [ -f "${OLD_WLAN_NETWORK_FILE}" ]; then
        FLEET_PASSWORD=$(sed -n 's/ *wpa-psk *.\(.*\)/\1/p')
    fi
    cat <<EOF > ${NETENV_FILE}
jaia_network_fleet_ssid="${FLEET_WLAN_SSID}"
jaia_network_fleet_password="${FLEET_PASSWORD}"
jaia_network_fleet_address="${FLEET_ADDRESS}"
jaia_network_fleet_gateway="${FLEET_GATEWAY}"
jaia_network_wifi_iface=wlan0
jaia_network_eth_iface=eth0
jaia_network_service_ssid="JaiaService"
jaia_network_service_password="jaia_service"
jaia_network_eth_enabled=false
EOF
else
    sed -i "s/fleet_ssid=.*/fleet_ssid=\"${FLEET_WLAN_SSID}\"/" ${NETENV_FILE}
    sed -i "s|fleet_address=.*|fleet_address=\"${FLEET_ADDRESS}\"|" ${NETENV_FILE}
    sed -i "s/fleet_gateway=.*/fleet_gateway=\"${FLEET_GATEWAY}\"/" ${NETENV_FILE}
fi

/usr/bin/jaia_update_network.sh


echo "<<<<< Updating wifi configuration complete (IP address changes won't take effect until reboot)!"
echo ">>>>> Updating hub0 address ... "
sed -i "s/.*hub0/${HUB0_WLAN_IP} hub0/" /etc/hosts
echo "<<<<< Updating hub0 address complete!"


echo ">>>>> Writing /etc/jaiabot/jaia.env ... "

# Identity for interactive shells and the 'jaia' tool, sourced by
# /etc/profile.d/jaia.sh. Deliberately identity-only: service configuration
# lives in the generated systemd units, so there is nothing here that can fall
# out of sync with them, and no secrets end up in every user's environment.
cat <<EOF > /etc/jaiabot/jaia.env
jaia_type=${JAIA_TYPE}
jaia_${JAIA_TYPE}_id=${BOT_OR_HUB_INDEX}
jaia_fleet_id=${FLEET_INDEX}
EOF

echo "<<<<< Writing /etc/jaiabot/jaia.env complete!"

echo ">>>>> Installing and enabling systemd services ... "

# systemd.py reads the rest of the configuration from debconf itself, so only
# the deployment layout is passed here. db_stop first: until the debconf
# frontend shuts down, its in-memory answers have not been flushed to the
# on-disk database that systemd.py reads.
db_stop

/usr/share/jaiabot/config/gen/systemd.py --enable \
                                         --jaiabot_bin_dir=/usr/bin \
                                         --jaiabot_share_dir=/usr/share \
                                         --goby_bin_dir=/usr/bin \
                                         --moos_bin_dir=/usr/bin \
                                         --gen_dir=/usr/share/jaiabot/config/gen \
                                         --systemd_dir=/usr/lib/systemd/system

echo "<<<<< Installing and enabling systemd services complete!"

shopt -s nullglob

echo ">>>>> Stopping, disabling, and removing jaia gps systemd services if they exist ... "
for service_file in /usr/lib/systemd/system/gps_*.service; do
    service_name=$(basename $service_file)
    echo "Stopping $service_name"
    /bin/systemctl stop $service_name || true
    echo "Disabling $service_name"
    /bin/systemctl disable $service_name
    echo "Removing $service_file"
    rm $service_file
done

echo ">>>>> Starting jaia firmware systemd services ... "
for service_file in /usr/lib/systemd/system/jaia_firm*.service; do
    service_name=$(basename $service_file)
    echo "Starting $service_name"
    if [ "$service_name" != "jaia_firm_hub-button-led-poweroff_py.service" ]; then
        /bin/systemctl start $service_name || true
    fi
done

echo ">>>>> Restarting gpsd"
/bin/systemctl restart gpsd.service

if [ "$JAIA_TYPE" = "bot" ]; then
    if [[ "$JAIA_ARDUINO_TYPE" != "none" ]]; then
        echo ">>>>> Flashing Arduino ..."
        /usr/share/jaiabot/arduino/jaiabot_runtime/${JAIA_ARDUINO_TYPE}/upload.sh
        echo "<<<<< Flashing Arduino complete!"
    fi
fi


echo ">>>>> Installing (but not enabling) Wireguard VPN ... "

/usr/share/jaiabot/config/gen/wireguard.py ${JAIA_TYPE} \
                                         --name wg_jaia \
                                         --bot_id=${BOT_OR_HUB_INDEX} \
                                         --hub_id=${BOT_OR_HUB_INDEX} \
                                         --fleet_id=${FLEET_INDEX}

echo ">>>>> Installing Wireguard VPN complete!"

# The 'j' alias and the jaia.env sourcing are provided to every login shell by
# /etc/profile.d/jaia.sh, which ships with this package.

echo "jaiabot-embedded version: $(dpkg-query --show --showformat='${Version}' jaiabot-embedded)" > /etc/jaiabot/software_version

if [ ! -f /etc/apt/apt.conf.d/99disable-auto-upgrades ]; then
    echo 'APT::Periodic::Update-Package-Lists "0";' > /etc/apt/apt.conf.d/99disable-auto-upgrades
    echo 'APT::Periodic::Unattended-Upgrade "0";' >> /etc/apt/apt.conf.d/99disable-auto-upgrades
    systemctl disable --now apt-daily.timer apt-daily-upgrade.timer
fi

#DEBHELPER#

exit 0
