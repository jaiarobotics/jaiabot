#!/bin/bash
set -e

# Change to the directory where requirements.txt resides
pushd /usr/share/jaiabot/python > /dev/null

    echo "🟢 Setting up Python virtual environment..."

    # 1. Bootstrap uv using the system pip if it's missing
    if ! command -v uv &> /dev/null; then
        echo "⬇️ uv not found, installing via pip..."
        # --break-system-packages is required on Ubuntu 24.04+ for system pip
        pip3 install -q uv --break-system-packages || pip3 install -q uv
    fi

    # 2. Create the venv using uv
    # --system-site-packages is critical so Python can see your 
    # system-installed Protobuf and DCCL libraries.
    uv venv venv --system-site-packages -q

    # 3. Install requirements
    # uv doesn't need 'pip install wheel' first; it handles builds natively.
    # We point uv specifically to the venv we just created.
    echo "📦 Installing Python dependencies..."
    uv pip install -q -r requirements.txt --python venv

    echo "✅ Virtual environment ready."

popd > /dev/null

#DEBHELPER#

exit 0