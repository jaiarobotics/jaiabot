#!/bin/sh

if [ "$1" = "purge" ]; then
    # generated by postinst, so dpkg does not track it
    rm -f /etc/jaiabot/jaia.env

    if [ -e /usr/share/debconf/confmodule ]; then
        # Source debconf library.
        . /usr/share/debconf/confmodule
        # Remove my changes to the db.
        db_purge
    fi
fi

exit 0
