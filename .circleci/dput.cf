[jaiabot-test-3.y]
login = dput
fqdn = packages.jaia.tech
method = scp
incoming = /var/www/html/ubuntu/test/3.y/mini-dinstall/incoming
allow_unsigned_uploads = 0
post_upload_command = ssh dput@packages.jaia.tech /usr/bin/mini-dinstall --batch --config=/opt/jaia_packages/mini-dinstall.conf /var/www/html/ubuntu/test/3.y

