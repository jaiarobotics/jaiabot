 164:Core/Src/system_stm32l4xx.c ****   /* The SystemCoreClock variable is updated in three ways:
 165:Core/Src/system_stm32l4xx.c ****       1) by calling CMSIS function SystemCoreClockUpdate()
 166:Core/Src/system_stm32l4xx.c ****       2) by calling HAL API function HAL_RCC_GetHCLKFreq()
 167:Core/Src/system_stm32l4xx.c ****       3) each time HAL_RCC_ClockConfig() is called to configure the system clock frequency
 168:Core/Src/system_stm32l4xx.c ****          Note: If you use this function to configure the system clock; then there
 169:Core/Src/system_stm32l4xx.c ****                is no need to call the 2 first functions listed above, since SystemCoreClock
 170:Core/Src/system_stm32l4xx.c ****                variable is updated automatically.
 171:Core/Src/system_stm32l4xx.c ****   */
 172:Core/Src/system_stm32l4xx.c ****   uint32_t SystemCoreClock = 4000000U;
 173:Core/Src/system_stm32l4xx.c **** 
