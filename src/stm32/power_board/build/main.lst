 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****   /* Allow USB host time to enumerate the CDC device before the first TX. */
 160:Core/Src/main.c ****   HAL_Delay(2000);
 161:Core/Src/main.c ****   /* USER CODE END 2 */
 162:Core/Src/main.c **** 
 163:Core/Src/main.c ****   /* Infinite loop */
 164:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 165:Core/Src/main.c ****   while (1)
 166:Core/Src/main.c ****   {
 167:Core/Src/main.c ****     /* USER CODE END WHILE */
 168:Core/Src/main.c **** 
 169:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 170:Core/Src/main.c ****     static const char hello_msg[] = "HELLO WORLD\r\n";
 171:Core/Src/main.c ****     HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET);
 172:Core/Src/main.c **** 
 173:Core/Src/main.c ****     uint8_t tx_status = USBD_BUSY;
 174:Core/Src/main.c ****     uint32_t tx_start = HAL_GetTick();
 175:Core/Src/main.c **** 
 176:Core/Src/main.c ****     do {
 177:Core/Src/main.c ****       tx_status = CDC_Transmit_FS((uint8_t *)hello_msg, sizeof(hello_msg) - 1U);
 178:Core/Src/main.c ****     } while (tx_status == USBD_BUSY && (HAL_GetTick() - tx_start) < 100U);
 179:Core/Src/main.c **** 
 180:Core/Src/main.c ****     HAL_Delay(50);
 181:Core/Src/main.c ****     HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_RESET);
 182:Core/Src/main.c **** 
 183:Core/Src/main.c ****     lptim_wake_flag = 0U;
 184:Core/Src/main.c ****     if (HAL_LPTIM_Counter_Start_IT(&hlptim1, LPTIM_10SEC_PERIOD) != HAL_OK)
 185:Core/Src/main.c ****     {
 186:Core/Src/main.c ****       Error_Handler();
 187:Core/Src/main.c ****     }
 188:Core/Src/main.c **** 
 189:Core/Src/main.c ****     HAL_SuspendTick();
 190:Core/Src/main.c ****     while (lptim_wake_flag == 0U)
 191:Core/Src/main.c ****     {
 192:Core/Src/main.c ****       HAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);
 193:Core/Src/main.c ****     }
 194:Core/Src/main.c ****     HAL_ResumeTick();
 195:Core/Src/main.c **** 
 196:Core/Src/main.c ****     HAL_LPTIM_Counter_Stop_IT(&hlptim1);
 197:Core/Src/main.c ****   }
 198:Core/Src/main.c ****   /* USER CODE END 3 */
 199:Core/Src/main.c **** }
