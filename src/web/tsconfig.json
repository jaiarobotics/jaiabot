{
    "compilerOptions": {
        "module": "CommonJS",
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "declaration": true,
        "moduleResolution": "node",
        "outDir": "dist",
        "rootDir": ".",
        "jsx": "react-jsx",
        "target": "ES2024",
        "esModuleInterop": true,
        "lib": ["ES2024", "dom"],
        "types": ["@testing-library/jest-dom", "@types/plotly.js", "@types/webpack-env", "node"],
        "resolveJsonModule": true
    },
    "exclude": ["node_modules", "dist", "coverage", "webpack.*.js", "*.config.js", "*.test.ts*"]
}
