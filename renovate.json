{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["3.y"],
  "enabledManagers": ["gomod", "custom.regex"],
  "labels": ["thirdparty"],
  "gomod": {
    "managerFilePatterns": ["/^src/web/thirdparty/caddy/go\\.mod$/"]
  },
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in an env file, each announced by a `# renovate:` line above it",
      "managerFilePatterns": [
        "/^src/web/thirdparty/versions\\.env$/",
        "/^scripts/common-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n[a-zA-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "caddy",
      "commitMessageTopic": "Caddy"
    },
    {
      "matchFileNames": ["src/web/thirdparty/versions.env"],
      "prBodyNotes": [
        "Before merging, run `src/web/thirdparty/fetch.sh --update-checksums` and commit the new SHA-256 lines in `versions.env`; the deb build refuses a tarball whose checksum does not match."
      ]
    },
    {
      "matchFileNames": ["scripts/common-versions.env"],
      "matchPackageNames": ["npm", "webpack", "webpack-cli", "node"],
      "groupName": "web build tools",
      "commitMessageTopic": "web build tools"
    }
  ]
}
