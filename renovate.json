{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["3.y"],
  "enabledManagers": ["gomod", "custom.regex"],
  "labels": ["thirdparty"],
  "gomod": {
    "managerFilePatterns": ["/^src/web/thirdparty/caddy/go\\.mod$/"]
  },
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in scripts/common-versions.env, each announced by a `# renovate:` line above it",
      "managerFilePatterns": ["/^scripts/common-versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\njaia_version_[a-z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "caddy",
      "commitMessageTopic": "Caddy"
    },
    {
      "matchPackageNames": ["authelia/authelia", "lldap/lldap"],
      "prBodyNotes": [
        "Before merging, run `src/web/thirdparty/fetch.sh --update-checksums` and commit the new `jaia_sha256_*` lines in `scripts/common-versions.env`; the deb build refuses a tarball whose checksum does not match."
      ]
    },
    {
      "matchPackageNames": ["npm", "webpack", "webpack-cli", "node"],
      "groupName": "web build tools",
      "commitMessageTopic": "web build tools"
    }
  ]
}
